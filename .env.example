# Auth redirect base URL (optional).
# Overrides window.location.origin when generating Supabase OAuth /
# password-reset redirect URLs. Set this when accessing the app through a
# public tunnel (ngrok, Cloudflare Tunnel, etc.) during development.
# The value MUST also be added to:
#   Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
# Leave blank to fall back to whatever origin the browser is currently on.
#VITE_SITE_URL=https://your-tunnel.ngrok-free.dev